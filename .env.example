# ---------------------------------------------------------------------------
# Canvas configuration. Copy to .env and replace every placeholder value.
# Never commit a real .env: it contains credentials.
# ---------------------------------------------------------------------------

# --- Required ---

# PostgreSQL 15+ database used by Canvas.
# Port 5433 is what docker-compose.yml publishes; 5432 is often already taken by
# another project's Postgres, and pointing Canvas at that one looks exactly like
# losing every account.
DATABASE_URL=postgresql://canvas:canvas@localhost:5433/canvas

# Where `npm test` runs. The integration suites truncate every table, so this
# must never be the database above. Left unset, the tests derive it by appending
# _test to the database name and create it themselves.
# TEST_DATABASE_URL=postgresql://canvas:canvas@localhost:5433/canvas_test

# Public origin of this Canvas instance. Used for links and preview frame ancestry.
APP_URL=http://localhost:3000

# Set to production in deployed environments to require Secure session cookies.
NODE_ENV=development

# HMAC secret for short-lived, project-scoped preview sessions (32+ random characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PREVIEW_TOKEN_SECRET=replace-with-at-least-32-random-characters

# --- Storage ---

# Private object storage for uploaded media and export archives.
# "local" writes under LOCAL_STORAGE_PATH; the path must be writable and backed up.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=.canvas-storage
MEDIA_MAX_BYTES=10485760

# --- AI credentials (server-only) ---

# Master key Canvas uses to encrypt workspace AI provider credentials at rest
# (AES-256-GCM). This is the only AI secret that belongs in the environment: provider
# API keys are entered per workspace in AI settings and are stored encrypted, never here.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Losing or changing it makes every stored provider credential unreadable, and each
# connection's key has to be entered again.
CANVAS_CREDENTIAL_KEY=

# How long Canvas waits for any AI provider before giving up.
AI_PROVIDER_TIMEOUT_MS=120000

# --- Optional: real provider smoke check (npm run test:ai-provider) ---
# Opt-in credentials for the paid smoke check only. It never reads a workspace
# connection, so running it cannot spend a workspace's key by accident.
# SMOKE_AI_PROVIDER=openai        # gemini | openai | anthropic | openai_compatible
# SMOKE_AI_MODEL=
# SMOKE_AI_API_KEY=
# SMOKE_AI_BASE_URL=

# --- Collaboration ---

INVITE_TTL_DAYS=7
LEASE_DURATION_SECONDS=60
PREVIEW_TOKEN_TTL_SECONDS=300

# --- Export ---

# "typecheck" (default) type-checks each exported project in process.
# "full" additionally runs npm install and next build for every export job:
# slower and requires network access from the worker.
CANVAS_EXPORT_BUILD=typecheck

# --- Background generation ---

# Where new AI generation jobs are sent.
#   queue  - publish the job id to Vercel Queues; the push consumer at
#            /api/queues/generation-jobs runs it. Default whenever VERCEL is set.
#   worker - leave the job for a polling `npm run worker`. Default off Vercel.
# Set to "queue" locally only after `vercel link && vercel env pull`.
# CANVAS_GENERATION_DISPATCH=worker

# Shared secret Vercel Cron presents to /api/cron/generation-maintenance. Required in
# any deployment on Vercel; without it the route refuses every request.
# CRON_SECRET=

# --- Operations (optional) ---

# When set, GET /api/internal/metrics returns process counters to callers presenting
# this value as a bearer token. Leave empty to disable the endpoint entirely.
CANVAS_METRICS_TOKEN=

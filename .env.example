# PostgreSQL 15+ database used by Canvas.
DATABASE_URL=postgresql://canvas:canvas@localhost:5432/canvas

# Public origin used for local links and future authentication redirects.
APP_URL=http://localhost:3000

# Set to production in deployed environments to require Secure session cookies.
NODE_ENV=development

# Collaboration defaults (optional).
INVITE_TTL_DAYS=7
LEASE_DURATION_SECONDS=60
